# Alpine Maintainer: qaqland <qaq@qaq.land>
# Maintainer: Leo Shen <yishen@qnx.com>
# Contributor Abdulfatah Ahmoda <abahmoda@qnx.com>
pkgname="sudo"
pkgver="1.9.17_p2"
_realver=${pkgver/_/}
pkgrel=0
pkgdesc="Give certain users the ability to run some commands as root"
url="https://www.sudo.ws"
arch="all"
license="LicenseRef-ISC"
depends="qnx-security qnx-io-sock"
makedepends="qnx-security-dev qnx-io-sock-dev ncurses-dev"
checkdepends="diffutils"
subpackages="$pkgname-doc $pkgname-dev"
source="
    https://github.com/qnx-ports/sudo/archive/refs/heads/qnx-v1.9.17p2.tar.gz
    sudo.pam
"
options="suid"
builddir="$srcdir/$pkgname-qnx-v$_realver"

build() {
    cd $builddir
    LDFLAGS="$LDFLAGS -lregex" \
    CFLAGS="$CFLAGS -Wno-error=incompatible-function-pointer-types"
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libexecdir=/usr/lib \
        --mandir=/usr/share/man \
        --with-rundir=/var/run/sudo \
        --with-vardir=/var/lib/sudo \
        --with-passprompt="[sudo] password for %p: " \
	--disable-shared \
	--disable-shared-libutil \
        --with-env-editor \
        --with-pam \
        --with-logfac=auth \
        --with-secure-path-value=/usr/bin \
	--with-editor=/usr/bin/vim \
        --with-all-insults
    make
}

check() {
    make check
}

package() {
    # the sudo's mkinstalldir script miscreates the leading
    # path components with bad permissions. fix this.
    install -d -m0755 "$pkgdir"/var "$pkgdir"/var/lib
    make -j1 DESTDIR="$pkgdir" install

    # Exactly the same as /etc/sudoers
    rm "$pkgdir"/etc/sudoers.dist

    # PAM
    pamdir="$pkgdir"/etc/pam.d/
    mkdir -p "$pamdir"
    install -m0444 "$srcdir"/sudo.pam "$pamdir"/sudo
}

